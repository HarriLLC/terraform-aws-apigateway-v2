{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/tf-fmt.sh",
            "timeout": 30,
            "statusMessage": "terraform fmt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/tf-validate.sh",
            "timeout": 180,
            "statusMessage": "terraform validate"
          }
        ]
      }
    ]
  }
}
